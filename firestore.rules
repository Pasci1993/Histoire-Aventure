rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Règle générale : Seuls les utilisateurs authentifiés peuvent lire/écrire
    // Cela s'applique à la structure par défaut des Immersives, utilisant l'ID de l'utilisateur.
    match /artifacts/{appId}/users/{userId}/{documents=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Règle pour les données publiques (si vous voulez partager des histoires/jeux)
    match /artifacts/{appId}/public/{documents=**} {
      // Les utilisateurs authentifiés peuvent lire ; seuls les administrateurs (ou vous) pouvez écrire
      allow read: if request.auth != null;
      allow write: if false; // Remplacer par une condition plus stricte pour la production
    }

    // Autoriser aussi la collection top-level /users/{userId} pour compatibilité
    // avec l'emplacement actuellement utilisé par l'application.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Si vous souhaitez une règle temporaire POUR LES TESTS (DANGEREUX EN PRODUCTION !) :
    /*
    match /{document=**} {
      allow read, write: if request.auth != null; // Seul un utilisateur connecté peut tout faire
    }
    */
  }
}
